{
  "uid": "lab33-servicios",
  "title": "Lab 3.3 — Servicios y SLO",
  "tags": ["lab33"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "1. Tasa HTTP /api",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"service-a|service-b|data-service\",http_route=~\"/api/(orders|fulfillment|records).*\"}[2m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "2. Latencia p95 y p99 de service-a",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"service-a\",http_route=~\"/api/orders/.*\"}[2m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"service-a\",http_route=~\"/api/orders/.*\"}[2m])))", "legendFormat": "p99" },
        { "refId": "C", "expr": "vector(0.150)", "legendFormat": "SLO 150 ms" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "3. Error rate de data-service frente a baseline + 2σ",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "refId": "A", "expr": "lab:data_service:error_ratio:2m", "legendFormat": "error rate" },
        { "refId": "B", "expr": "lab:data_service:error_ratio:baseline10m + 2 * lab:data_service:error_ratio:stddev10m", "legendFormat": "baseline + 2σ" },
        { "refId": "C", "expr": "vector(0.05)", "legendFormat": "umbral estático 5 %" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "4. SLI de éxito de service-a",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "refId": "A", "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"service-a\",http_route=~\"/api/orders/.*\",http_response_status_code=~\"2..\"}[$__range])) / clamp_min(sum(increase(http_server_request_duration_seconds_count{service_name=\"service-a\",http_route=~\"/api/orders/.*\"}[$__range])), 1e-9)" }]
    },
    {
      "id": 5, "type": "stat", "title": "5. Alertas activas",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "6. Inyecciones de caos y salud del Collector",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(chaos_latency_injections_total[2m]))", "legendFormat": "latencia inyectada" },
        { "refId": "B", "expr": "sum(rate(chaos_errors_injected_total[2m]))", "legendFormat": "errores inyectados" },
        { "refId": "C", "expr": "up{job=\"otel-collector\"}", "legendFormat": "collector up" }
      ]
    }
  ]
}
